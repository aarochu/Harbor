# Copy to agent/.env and fill in. Never commit the filled-in file.

# --- Model provider -------------------------------------------------
# Set ANTHROPIC_API_KEY to use Anthropic directly (simplest path).
# Leave it empty to fall back to Amazon Bedrock (the Strands default).
ANTHROPIC_API_KEY=

# Bedrock path only.
#
# Model access is enabled per region, and this value wins over the region
# in your AWS profile — model.ts reads AWS_REGION directly. Keep the two
# in step or you get an AccessDenied that looks like a policy problem.
AWS_REGION=us-east-1

# Pick ONE of the two ways to authenticate to Bedrock.
#
# (a) A named CLI profile — preferred when this machine has more than one
#     AWS account configured. Harbor's credits live in one specific
#     account, and a default profile pointing at a different one means
#     calls either fail or bill a real card instead of drawing down the
#     credits.
#
#       aws configure --profile harbor
#
#     Then set:
# AWS_PROFILE=harbor
#
# (b) Keys inline. Only if you are not using profiles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional override, e.g. claude-sonnet-4-6 (Anthropic)
# or global.anthropic.claude-sonnet-4-6 (Bedrock)
HARBOR_MODEL_ID=

# --- Harbor tool credentials ----------------------------------------
# GITHUB_TOKEN is only needed for private repos; M1 profiles public ones
# anonymously. It becomes required at M4, which commits fixes to a branch.
GITHUB_TOKEN=
# Render workspace id (GET /v1/owners). Not a secret.
RENDER_OWNER_ID=
RENDER_API_KEY=

# Cost control (project runs on a fixed $100 AWS credit balance).
# Caps output tokens per model call. Default 4096.
HARBOR_MAX_TOKENS=4096

# Harbor's own state store (docker compose up -d, then npm run db:migrate)
DATABASE_URL=postgres://harbor:harbor_local_dev@localhost:5433/harbor
